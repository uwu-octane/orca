{
  "include": ["**/*.ts", "**/*.tsx"],
  // vendor/ is pulled into the program via its package import (single module
  // identity); including it here would typecheck the same files twice.
  "exclude": ["web/**/*", "badseo/**/*", "vendor/**/*"],
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true
  }
}
